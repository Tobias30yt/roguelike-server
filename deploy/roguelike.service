[Unit]
Description=Roguelike Paper Minecraft server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/srv/roguelike
Environment=JAVA_XMS=512M
Environment=JAVA_XMX=2G
EnvironmentFile=-/etc/default/roguelike
ExecStart=/opt/roguelike-java25/bin/java --enable-native-access=ALL-UNNAMED -Dterminal.jline=false -Dterminal.ansi=false -Xms${JAVA_XMS} -Xmx${JAVA_XMX} -jar paper.jar --nogui
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
SuccessExitStatus=0 130 143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/roguelike
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
